{
  "name": "@vietsch/svelte-video-player-kit",
  "version": "2.0.0",
  "type": "module",
  "author": "Volker von Vietsch",
  "description": "Basic video player component for Svelte, SSR and SvelteKit apps.",
  "homepage": "https://github.com/vietsch/svelte-video-player-kit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vietsch/svelte-video-player-kit.git"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "ssr",
    "video",
    "player"
  ],
  "svelte": "./src/lib/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "svelte": "./src/lib/index.js",
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "sync": "svelte-kit sync",
    "check": "npm run sync --silent && svelte-check",
    "check:watch": "svelte-check --watch",
    "package": "svelte-package",
    "prepublishOnly": "npm run check && npm run package"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@sveltejs/adapter-auto": "^3.3.1",
    "@sveltejs/kit": "^2.5.0",
    "@sveltejs/package": "^2.3.2",
    "@types/node": "^22.8.6",
    "sass-embedded": "^1.93.2",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.2",
    "typescript": "^5.4.0",
    "vite": "^6.3.0"
  },
  "publishConfig": {
    "directory": "package"
  }
}

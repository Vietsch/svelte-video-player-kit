{
  "name": "@vietsch/svelte-video-player-kit",
  "version": "1.0.2",
  "author": "Volker von Vietsch / Meigo Kukk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vietsch/svelte-video-player-kit"
  },
  "description": "Basic video player component for svelte, SSR and sveltekit apps.",
  "homepage": "https://github.com/Vietsch/svelte-video-player-kit",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "svelte": "./src/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/svelte-video-player.js"
    }
  },
  "svelte": "./src/index.js",
  "module": "./dist/index.mjs",
  "main": "./dist/svelte-video-player.js",
